# Google Apps Script web app URL that receives beta waiting-list submissions.
# Deploy apps-script/Code.gs (Deploy -> New deployment -> Web app,
# "Execute as: Me", "Who has access: Anyone") and paste the /exec URL here.
#
# Copy this file to .env.local and fill in the value:
#   cp .env.example .env.local
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=
